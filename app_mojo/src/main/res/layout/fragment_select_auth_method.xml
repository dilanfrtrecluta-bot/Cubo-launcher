<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="#060C09">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="22dp">
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tu cuenta" android:textSize="30sp" android:textStyle="bold" android:textColor="#EDF6F0" android:layout_marginTop="18dp"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Elige cómo quieres iniciar sesión en Cubo." android:textSize="15sp" android:textColor="#9AAFA1" android:layout_marginTop="10dp" android:layout_marginBottom="28dp"/>
  <Button android:id="@+id/button_microsoft_authentication" android:layout_width="match_parent" android:layout_height="64dp" android:text="Cuenta Microsoft" android:textAllCaps="false"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Inicia sesión con tu cuenta de Minecraft." android:textSize="13sp" android:textColor="#9AAFA1" android:padding="12dp"/>
  <Button android:id="@+id/button_elyby_authentication" android:layout_width="match_parent" android:layout_height="64dp" android:text="Cuenta Ely.by" android:textAllCaps="false" android:layout_marginTop="12dp"/>
  <Button android:id="@+id/button_local_authentication" android:layout_width="match_parent" android:layout_height="64dp" android:text="Perfil local" android:textAllCaps="false" android:layout_marginTop="18dp"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Un perfil local no sustituye una licencia de Minecraft ni permite entrar en servidores que requieren autenticación oficial." android:textSize="13sp" android:textColor="#9AAFA1" android:padding="12dp"/>
 </LinearLayout>
</ScrollView>
